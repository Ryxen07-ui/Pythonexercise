#Exam Grade (1)


Mark = int(input("Enter the marks : "))

if Mark >= 90:
    print("Grade A")
elif Mark >= 80:
    print("Grade B")
elif Mark >= 70:
    print("Grade C")
elif Mark >= 60:
    print("Grade D")
elif Mark >= 40:
    print("Grade E")
else:
    print("Fail")


#Game Score (2)

Score = int(input("Enter Game Score : "))

if Score >= 1000:
    print("Diamond")
elif Score >= 700:
    print("Gold")
elif Score >= 500:
    print("Silver")
elif Score >= 300:
    print("Bronze")
elif Score >= 100:
    print("Beginner")
else:
    print("New Player")

# Battery Percentage (3)

BTTpercentage = int(input("Enter Battery Percentage : "))

if BTTpercentage >= 90:
    print("Full")
elif BTTpercentage >= 70:
    print("High")
elif BTTpercentage >= 50:
    print("Medium")
elif BTTpercentage >= 30:
    print("Low")
elif BTTpercentage >= 10:
    print("Very Low")
else:
    print("Critical")

#Traffic Light (4)

TrafficLC = str(input("Enter the traffic light color : "))

if TrafficLC == "Red":
    print("Stop")
elif TrafficLC == "Yellow":
    print("Get Ready")
elif TrafficLC == "Green":
    print("Go")
else:
    print("Unknow Color")

